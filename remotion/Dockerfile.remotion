# Remotion render microservice.
# Node + the system libraries headless Chrome (downloaded by @remotion/renderer
# on first render) needs to run. fonts-noto-cjk gives Chinese subtitle glyphs.
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libdbus-1-3 libatk1.0-0 libgbm-dev libasound2 libxrandr2 \
    libxkbcommon-dev libxfixes3 libxcomposite1 libxdamage1 libatk-bridge2.0-0 \
    libpango-1.0-0 libcairo2 libcups2 fonts-liberation fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY . .

# Pre-download the headless browser so the first render isn't slow.
RUN npx remotion browser ensure || true

ENV REMOTION_OUTPUT_ROOT=/app/output
ENV REMOTION_RENDER_PORT=3001
EXPOSE 3001

CMD ["node", "server.mjs"]
